# Database configuration (PostgreSQL for Docker/Production, SQLite supported for local lightweight dev/tests)
DATABASE_URL=sqlite:///./data/brpredictor.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/brpredictor

# LLM Configuration (mock | ollama | openai | gemini)
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
OPENAI_API_KEY=
GEMINI_API_KEY=

# News & Temporal cutoff settings
NEWS_STORAGE_POLICY=METADATA_ONLY
AS_OF_HOURS=24
MODEL_REGISTRY_PATH=./artifacts
LOG_LEVEL=INFO

# Admin API token for manual news ingestion
ADMIN_API_TOKEN=dev-secret-token-123
